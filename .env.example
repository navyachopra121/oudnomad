# =============================================================================
# oudnomad-store — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env — it is listed in .gitignore.
# All variables listed here are REQUIRED unless marked [optional].
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Supabase (PostgreSQL)
# -----------------------------------------------------------------------------
# Supabase project: Settings → Database → Connection string (URI format)
# Use the "Transaction" mode URL (port 6543) for Prisma in serverless/Edge,
# or the direct "Session" mode URL (port 5432) for persistent connections.
# For NestJS (long-lived process), use the Session mode (port 5432).
DATABASE_URL=

# -----------------------------------------------------------------------------
# Redis — local Docker (see docker-compose.yml)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Token expiry durations (e.g. 15m, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Payments — Razorpay (or mock)
# -----------------------------------------------------------------------------
# Supported providers: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Stripe — Payments (legacy/optional)
# -----------------------------------------------------------------------------
# Dashboard → Developers → API Keys
# Use test mode keys (sk_test_... / pk_test_...) for development
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stripe CLI: stripe listen --forward-to localhost:3001/payments/webhook
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Cloudinary — File & Image Storage
# -----------------------------------------------------------------------------
# Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Email — Transactional Notifications
# -----------------------------------------------------------------------------
# Supported providers: resend | sendgrid | mailgun
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
# NestJS API port
PORT=3001
# Next.js public API base URL (used by frontend to reach the backend)
NEXT_PUBLIC_API_URL=http://localhost:3001
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
